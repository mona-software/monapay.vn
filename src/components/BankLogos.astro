---
// Dải logo ngân hàng — logo CHÍNH THỐNG (VietQR/Napas, nền trong). TẤT CẢ ngân hàng đã tích hợp
// đều gắn dấu tích xanh. VA banks (tài khoản ảo thật) xếp trước, rồi tới nhóm báo-có-biến-động.
import { LIVE_BANKS, VA_BANKS, BANKS_COUNT } from '../data/banks';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const smsBanks = LIVE_BANKS.filter((b) => !b.features?.va);
const banks = [...VA_BANKS, ...smsBanks];
---
<section class={compact ? 'banklogos banklogos--compact' : 'banklogos section-alt'}>
  <div class="wrap">
    {!compact && (
      <>
        <span class="eyebrow">Ngân hàng</span>
        <h2>Đã tích hợp {BANKS_COUNT} ngân hàng<br class="br-d" /> Việt Nam</h2>
        <p class="banklogos-lead answer-first">MONA Pay là API ngân hàng tự động báo có khi khách chuyển khoản: khách chuyển vào tài khoản đứng tên anh chị, tiền vào là báo ngay về website, phần mềm, Telegram, đơn tự chuyển sang đã thanh toán. Đã tích hợp <strong>{BANKS_COUNT} ngân hàng</strong> — {VA_BANKS.length} ngân hàng có tài khoản ảo (VA) và báo có realtime, còn lại báo có qua biến động số dư. Xem trạng thái ở <a href="/ngan-hang">trang ngân hàng hỗ trợ</a>.</p>
      </>
    )}
    <ul class="banklogos-grid" role="list">
      {banks.map((b) => (
        <li class="banklogos-cell is-live">
          <a href={'/' + b.slug} class="banklogos-link" aria-label={`${b.name} — đã tích hợp`}>
            <img src={`/img/banks/${b.slug}.png`} alt={b.name} width="831" height="311" loading="lazy" decoding="async" />
          </a>
          <span class="banklogos-check" title="Đã tích hợp" aria-hidden="true">✓</span>
        </li>
      ))}
    </ul>
    {!compact && <p class="banklogos-note">Tất cả {BANKS_COUNT} ngân hàng đã tích hợp. Logo là nhãn hiệu của các ngân hàng tương ứng, dùng để nhận diện ngân hàng khách chuyển khoản.</p>}
  </div>
</section>

<style>
  .banklogos{padding-top:40px}
  .banklogos--compact{padding:32px 0}
  .banklogos-lead{max-width:70ch;color:var(--text-soft);margin:.2rem 0 1.6rem}
  .banklogos-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
  .banklogos-cell{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px 12px;display:flex;align-items:center;justify-content:center;min-height:70px;box-shadow:var(--shadow)}
  .banklogos-cell.is-live{border-color:#b6ddc8}
  .banklogos-link{display:flex;align-items:center;justify-content:center;width:100%;height:100%;transition:transform .15s ease}
  .banklogos-link:hover{transform:translateY(-2px)}
  .banklogos-cell img{width:100%;height:auto;max-height:38px;object-fit:contain}
  .banklogos-check{position:absolute;top:6px;right:6px;width:17px;height:17px;border-radius:50%;background:var(--success,#14734d);color:#fff;font-size:11px;font-weight:800;line-height:17px;text-align:center;box-shadow:0 1px 3px rgba(0,0,0,.15)}
  .banklogos-note{color:var(--text-soft);font-size:.78rem;margin:1.5rem 0 0}
  @media (max-width:900px){.banklogos-grid{grid-template-columns:repeat(4,1fr)}}
  @media (max-width:560px){.banklogos-grid{grid-template-columns:repeat(3,1fr);gap:10px}.banklogos-cell{min-height:60px;padding:11px 9px}.banklogos-cell img{max-height:30px}}
</style>
